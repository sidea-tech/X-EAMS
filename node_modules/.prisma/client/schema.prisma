// Employee Attendance Management System — data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
}

/// Final state of one employee-day.
enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum PunchSource {
  WEB
  ADMIN
}

model User {
  id           String  @id @default(cuid())
  employeeCode String  @unique
  username     String  @unique
  passwordHash String
  fullName     String
  email        String? @unique
  phone        String?
  department   String?
  designation  String?
  role         Role    @default(EMPLOYEE)
  isActive     Boolean @default(true)

  /// Bumped on password change / deactivation so existing JWTs stop working.
  tokenVersion Int       @default(0)
  joinedAt     DateTime  @default(now())
  lastLoginAt  DateTime?

  // Brute-force protection
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances   Attendance[]
  editedRecords Attendance[] @relation("AttendanceEditor")
  auditLogs     AuditLog[]   @relation("AuditActor")

  @@index([role, isActive])
  @@index([department])
}

model Attendance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Calendar day in APP_TIMEZONE, normalised to UTC midnight.
  date DateTime @db.Date

  firstCheckIn  DateTime?
  lastCheckOut  DateTime?
  /// Sum of all completed sessions, in minutes.
  workedMinutes Int              @default(0)
  status        AttendanceStatus @default(PRESENT)
  isLate        Boolean          @default(false)
  isEarlyOut    Boolean          @default(false)
  note          String?

  editedById String?
  editedBy   User?     @relation("AttendanceEditor", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt   DateTime?

  sessions PunchSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId, date])
  @@index([status])
}

/// One IN→OUT pair. Multiple per day supports breaks and split shifts.
model PunchSession {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  checkInAt  DateTime
  checkOutAt DateTime?

  checkInIp  String?
  checkOutIp String?
  source     PunchSource @default(WEB)
  note       String?

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([checkOutAt])
}

/// Company-wide attendance rules. Single row, id = "default".
model WorkPolicy {
  id             String @id @default("default")
  /// "HH:mm" in APP_TIMEZONE
  workStart      String @default("09:30")
  workEnd        String @default("18:30")
  graceMinutes   Int    @default(15)
  fullDayMinutes Int    @default(480)
  halfDayMinutes Int    @default(240)
  /// Weekday numbers that are working days (0 = Sunday).
  workingDays    Int[]  @default([1, 2, 3, 4, 5])
  timezone       String @default("Asia/Kolkata")

  updatedAt DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
