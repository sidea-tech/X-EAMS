# ---- Database (Prisma Postgres / any Postgres) ----
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"
SESSION_TTL_HOURS="9"

# ---- Company / locale ----
APP_TIMEZONE="Asia/Kolkata"
APP_NAME="X-EAMS"

# ---- Seed bootstrap (used only by `npm run db:seed`) ----
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-to-something-strong"
SEED_DEMO_DATA="false"

# ---- One-time bootstrap (optional) ----
# Set to a long random value to enable POST /api/bootstrap, which creates the
# first administrator when the database is only reachable from the deployment.
# Remove it again once the administrator exists.
# BOOTSTRAP_TOKEN="another-long-random-string-min-16-chars"
